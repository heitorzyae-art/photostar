<?xml version="1.0" encoding="utf-8"?>
<!--
  PhotoStar MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build photostar.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc photostar.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\PhotoStar by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch PhotoStar" box. Installs a Start Menu shortcut, makes
  PhotoStar the owner of `.pcraft`, and offers it under "Open with" for PSD/PSB and the image
  formats it reads (without taking over the user's default app for them), plus photostar-cli.
  `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="PhotoStar"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="D9660F32-2D0A-4ABE-B73D-17BE25F1542C"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="PhotoStar image editor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of PhotoStar is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="PhotostarIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PhotostarIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/photocraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/photocraft" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="PhotoStar" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by PhotostarApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\PhotoStar" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="PhotoStar" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif ?>
      <ComponentGroupRef Id="PhotostarFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPhotostar"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through photostar.en-us.wxl. -->
    <Property Id="PhotostarVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="PhotoStar $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch PhotoStar" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PhotostarExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchPhotostar" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif ?>
    <ComponentGroup Id="PhotostarFiles" Directory="INSTALLFOLDER">
      <Component Id="PhotostarApp" Guid="A6DE41B7-A80F-4C59-A17E-BB68065BF67E">
        <File Id="PhotostarExe" Source="$(var.BinDir)\photostar.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="PhotoStar"
              Description="PhotoStar image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="PhotostarIcon.exe" IconIndex="0" />
        </File>

        <!-- .pcraft: PhotoStar's own format; PhotoStar is its default app. -->
        <ProgId Id="Photostar.Document" Description="PhotoStar Document" Icon="PhotostarExe" IconIndex="0">
          <Extension Id="pcraft" ContentType="application/x-photostar">
            <Verb Id="open" Command="Open" TargetFile="PhotostarExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Photostar.PhotoshopDocument" Description="PSD Document" Icon="PhotostarExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Photostar.PhotoshopDocument\shell\open\command" Value="&quot;[#PhotostarExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="Photostar.Image" Description="Image" Icon="PhotostarExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Photostar.Image\shell\open\command" Value="&quot;[#PhotostarExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psd\OpenWithProgids" Name="Photostar.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psb\OpenWithProgids" Name="Photostar.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdn\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ora\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.kra\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.krz\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tif\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tiff\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.webp\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.gif\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bmp\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tga\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.exr\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.hdr\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.avif\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.qoi\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ico\OpenWithProgids" Name="Photostar.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "photostar"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe" Name="FriendlyAppName" Value="PhotoStar" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\shell\open\command" Value="&quot;[#PhotostarExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".pcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".kra" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".krz" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostar.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\photostar.exe" Value="[#PhotostarExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PhotoStar" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="PhotostarCli">
        <File Id="PhotostarCliExe" Source="$(var.BinDir)\photostar-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
